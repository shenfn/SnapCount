{
  "version": "expression-core-legacy-compat-v0.1",
  "description": "第一切片迁移前的结构化行为快照；不包含模型文案或用户数据。",
  "core_cases": [
    {
      "name": "legacy_number_from_decimal_string",
      "operation": "parseFiniteNumber",
      "args": [" 12.50 "],
      "expected": 12.5
    },
    {
      "name": "legacy_invalid_number_is_null",
      "operation": "parseFiniteNumber",
      "args": ["NaN"],
      "expected": null
    },
    {
      "name": "legacy_money_rounding",
      "operation": "roundMoney",
      "args": [12.345, 2],
      "expected": 12.35
    },
    {
      "name": "legacy_entity_normalization",
      "operation": "normalizeEntityText",
      "args": [" 星巴克（西湖店） "],
      "expected": "星巴克西湖店"
    },
    {
      "name": "legacy_pending_fact_scope",
      "operation": "buildExpenseFactContract",
      "args": [{ "status": "pending_review", "category": "food" }],
      "expected": {
        "contract_version": "expense-fact-contract-v0.1",
        "fact_status": "pending_review",
        "cashflow_scope": "exclude_pending_review",
        "expense_total_scope": "exclude_pending_review",
        "comparison_scope": "pending_review",
        "comparison_cohort": "expense.category.food"
      }
    },
    {
      "name": "legacy_housing_rent_scope",
      "operation": "buildExpenseFactContract",
      "args": [{ "status": "done", "business_kind": "housing_rent" }],
      "expected": {
        "contract_version": "expense-fact-contract-v0.1",
        "fact_status": "confirmed",
        "cashflow_scope": "include",
        "expense_total_scope": "include",
        "fixed_expense_scope": "include",
        "comparison_cohort": "expense.fixed.housing"
      }
    }
  ],
  "fallback_cases": [
